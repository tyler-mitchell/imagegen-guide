    "7": { "prompt": "Image row 8 of 10: use its ten listed icons in order." },
    "8": { "prompt": "Image row 9 of 10: use its ten listed icons in order." },
    "9": {
      "prompt": "Image row 10 of 10: use its ten listed icons in order, filling the bottom edge. No footer or unused band."
    }
  },
  "appearance": {
    "background": "#ffffff",
    "image": {
      "fill": "#ffffff",
      "backgroundImage": "linear-gradient(45deg, #cbd5e1 25%, transparent 25%), linear-gradient(-45deg, #cbd5e1 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #cbd5e1 75%), linear-gradient(-45deg, transparent 75%, #cbd5e1 75%)",
      "backgroundSize": "16px 16px",
      "backgroundPosition": "0 0, 0 8px, 8px -8px, -8px 0",
      "stroke": "#111827",
      "strokeWidth": 2,
      "radius": 0
    }
  },
  "prompt": "Create exactly 100 app icons in exactly 10 columns and 10 rows, matching the schematic's continuous square lattice. Each cell occupies exactly 1/10 of the canvas width and 1/10 of its height. Fill EVERY square completely, including the bottom-right cell. Each icon background reaches all four edges and corners of its square. Use sharp 90-degree corners: NO rounded tiles, rounded clipping, corner cutouts, transparent corners, whitespace, gutters, outer margins, or blank cells. Adjacent square backgrounds touch. Keep each symbol inside its own square. Use the supplied icon order, left to right then top to bottom. Replace all checkerboards and lattice lines with artwork. No captions, guide lines, checkerboards, exterior shadows, or extra rows or columns. Use consistent crisp symbols and subtle internal depth.",
