{
  "id": "100-app-icons-lattice",
  "layout": "grid",
  "canvas": {
    "width": 2000,
    "aspectRatio": "1:1",
    "padding": 0
  },
  "grid": {
    "columns": 10,
    "gap": 0,
    "padding": 0
  },
  "defaults": {
    "aspectRatio": "1:1",
    "label": false
  },
  "rows": {
    "0": { "prompt": "Image row 1 of 10: use its ten listed icons in order." },
    "1": { "prompt": "Image row 2 of 10: use its ten listed icons in order." },
    "2": { "prompt": "Image row 3 of 10: use its ten listed icons in order." },
    "3": { "prompt": "Image row 4 of 10: use its ten listed icons in order." },
    "4": { "prompt": "Image row 5 of 10: use its ten listed icons in order." },
