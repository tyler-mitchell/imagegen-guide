{
  "name": "imagegen-guide-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "environment": "publish",
    "permissions": "publish"
  },
  "scripts": {
    "cli": "node packages/imagegen-guide/examples/generate.ts",
    "check": "pnpm --filter imagegen-guide run check",
    "build": "vp run -r build",
    "dependencies:close": "gh pr close",
    "dependencies:list": "gh pr list --state open --search 'author:app/dependabot' --limit 100",
    "dependencies:merge": "gh pr merge --squash",
    "dependencies:sync": "git pull --ff-only origin main",
    "ci:cancel": "gh run cancel",
    "ci:dispatch": "gh workflow run ci.yml",
    "ci:list": "gh run list --limit 10",
    "ci:logs": "gh run view --log-failed",
    "ci:rerun": "gh run rerun",
    "ci:watch": "gh run watch --exit-status",
    "release:add": "bumpy add",
    "release:check": "bumpy check --strict",
    "release:merge": "gh pr merge bumpy/version-packages --auto --squash",
    "release:pr": "gh pr list --head bumpy/version-packages --base release --state open --limit 1",
    "release:promote:create": "gh pr create --head main --base release --fill",
    "release:promote:merge": "gh pr merge main --merge --auto",
    "release:promote:pr": "gh pr list --head main --base release --state open --limit 1",
    "release:publish-and-trust-new-package": "npm whoami || npm login && fledgling add imagegen-guide --new",
    "release:push": "git push origin main",
    "release:registry-version": "npm view imagegen-guide version",
    "release:sync": "git pull --ff-only origin release",
    "release:sync:merge": "git pull --no-rebase --no-edit origin release",
    "release:sync:push": "git push origin main",
    "release:trust-sync": "fledgling sync",
    "release:status": "bumpy status --json",
    "release:update": "gh pr update-branch bumpy/version-packages",
    "release:preflight": "node scripts/verify-package.ts",
    "release:verify": "node scripts/verify-release.ts",
    "setup:identity": "gh api user --jq .login",
    "setup:install": "pnpm install",
    "setup:bumpy:init": "bumpy init --force",
    "setup:bumpy": "bumpy ci setup",
    "setup:bumpy:secrets": "gh secret list --json name --jq '.[].name'",
    "setup:bumpy:token": "gh auth token | gh secret set BUMPY_GH_TOKEN",
    "setup:base-branch": "git push origin main:release",
    "setup:branch-protection": "gh api --silent --method PUT repos/{owner}/{repo}/branches/release/protection --input .github/branch-protection.json",
    "setup:repository:create": "gh repo create tyler-mitchell/imagegen-guide --public --source=. --remote=origin",
    "setup:repository": "gh api --silent --method PATCH repos/{owner}/{repo} --field allow_auto_merge=true --field allow_update_branch=true --field delete_branch_on_merge=true",
    "workflow:check": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 .github/workflows/*.yml"
  },
  "devDependencies": {
    "@varlock/bumpy": "1.18.1",
    "fledgling": "1.2.1",
    "npm": "^11.15.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
